<Window x:Class="FNS_graphics.DigitalSignatureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки цифровой подписи"
        Height="680"
        Width="980"
        MinWidth="660"
        MinHeight="460"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#FFF2F8F2" />
            <Setter Property="Foreground" Value="#FF1F3A2A" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F8F1" />
            <Setter Property="BorderBrush" Value="#FFC4DCC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderBrush" Value="#FFB6CCB8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4,12,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#FF70B07D" />
            <Setter Property="Foreground" Value="#FF193B26" />
            <Setter Property="BorderBrush" Value="#FF5A996A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFC63870" />
            <Setter Property="BorderBrush" Value="#FF9A2A56" />
            <Setter Property="Foreground" Value="#FFF8F2F4" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#FFB6CCB8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleStyle}" Margin="0">
                                Настройка ключей цифровой подписи для ролей отправителя и получателя.
                            </TextBlock>
                            <CheckBox x:Name="SignCiphertextCheckBox"
                                      Grid.Column="1"
                                      Content="Подписывать шифротекст"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      Margin="12,0,0,0" />
                        </Grid>

                        <TextBlock FontSize="13"
                                   Foreground="#FF4A5C50"
                                   Margin="0,2,0,0">
                            1) Данными ключами можно обменяться только по защищённым каналам связи
                            <LineBreak />
                            2) Списки собственных и доверенных ключей не синхронизируются между отправителем и получателем автоматически и заполняются вручную
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8">Мои долгосрочные ключи подписи (роль: отправитель)</TextBlock>

                        <TextBlock Margin="0,0,0,2" VerticalAlignment="Bottom">Введите новый или сгенерируйте свой публичный ключ подписи</TextBlock>
                        <TextBox x:Name="OwnSenderPublicKeyTextBox" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,10">
                            <Button Content="Сгенерировать ключ"
                                    Click="GenerateSenderLongTermKeyButton_Click"
                                    Margin="0,0,10,0" />
                            <Button Content="Добавить в мои ключи"
                                    Click="AddOwnSenderKeyButton_Click"
                                    Margin="0" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,2" VerticalAlignment="Bottom">Список моих публичных ключей подписи отправителя</TextBlock>
                        <ListBox x:Name="OwnSenderSigningKeysListBox"
                                 Margin="0,0,0,12"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Public_key, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Active_label, Mode=OneWay}"
                                                       Foreground="#FF2E6F43"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <Button Content="Сделать активным"
                                                    Tag="{Binding Public_key}"
                                                    IsEnabled="{Binding Can_select, Mode=OneWay}"
                                                    Click="SelectOwnSenderKeyButton_Click"
                                                    Margin="0,0,8,0" />
                                            <Button Content="Удалить"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Tag="{Binding Public_key}"
                                                    Click="RemoveOwnSenderKeyButton_Click"
                                                    Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8">Доверенные ключи подписи (роль: получатель)</TextBlock>

                        <TextBlock Margin="0,0,0,2" VerticalAlignment="Bottom">Введите публичный ключ отправителя, которому доверяете</TextBlock>
                        <TextBox x:Name="TrustedSenderPublicKeyTextBox" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,10">
                            <Button Content="Добавить в доверенные"
                                    Click="AddTrustedSenderKeyButton_Click"
                                    Margin="0" />
                        </StackPanel>

                        <TextBlock Margin="0,0,0,2" VerticalAlignment="Bottom">Список доверенных публичных ключей отправителей</TextBlock>
                        <ListBox x:Name="TrustedSenderKeysListBox"
                                 Margin="0,0,0,10"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                         <TextBox Grid.Column="0"
                                                 Text="{Binding ., Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Content="Удалить"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                Tag="{Binding}"
                                                Click="RemoveTrustedSenderKeyButton_Click"
                                                Margin="0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
