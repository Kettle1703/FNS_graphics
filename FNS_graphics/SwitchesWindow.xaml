<Window x:Class="FNS_graphics.SwitchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переключатели режимов"
        Height="520"
        Width="860"
        MinHeight="420"
        MinWidth="700"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#FFF2F8F2" />
            <Setter Property="Foreground" Value="#FF1F3A2A" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F8F1" />
            <Setter Property="BorderBrush" Value="#FFC4DCC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4,12,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#FF70B07D" />
            <Setter Property="Foreground" Value="#FF193B26" />
            <Setter Property="BorderBrush" Value="#FF5A996A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SoftToggleContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFE2ECE3" />
            <Setter Property="BorderBrush" Value="#FF9FB9A3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="SoftToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF274235" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="Padding" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}">
                            Управление созданием JSON-файла, в который записываются все зашифрованные данные.
                        </TextBlock>
                        <Border Style="{StaticResource SoftToggleContainerStyle}" Margin="0,0,0,8">
                            <CheckBox x:Name="BuildJsonFileCheckBox"
                                      Content="Собрирать JSON файл"
                                      Style="{StaticResource SoftToggleCheckBoxStyle}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}">
                            Внешняя защита JSON-пакета кодом Рида-Соломона для устойчивости к ошибкам передачи.
                        </TextBlock>
                        <Border Style="{StaticResource SoftToggleContainerStyle}" Margin="0,0,0,8">
                            <CheckBox x:Name="ApplyReedSolomonForJsonCheckBox"
                                      Content="Применять Рида-Соломона к JSON файлу"
                                      Style="{StaticResource SoftToggleCheckBoxStyle}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}">
                            Режим генерации публичного ключа отправителя в гибридное схеме шифрования.
                        </TextBlock>
                        <Border Style="{StaticResource SoftToggleContainerStyle}" Margin="0,0,0,8">
                            <CheckBox x:Name="AutoSenderKeyGenerationCheckBox"
                                      Content="Автогенерация новых ключей"
                                      Style="{StaticResource SoftToggleCheckBoxStyle}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}">
                            Наложение цифровой подписи на весь пакет шифротекста.
                        </TextBlock>
                        <Border Style="{StaticResource SoftToggleContainerStyle}" Margin="0,0,0,8">
                            <CheckBox x:Name="SignCiphertextCheckBox"
                                      Content="Подписывать шифротекст"
                                      Style="{StaticResource SoftToggleCheckBoxStyle}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Button Content="Закрыть"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
