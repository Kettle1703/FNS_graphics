<Window x:Class="FNS_graphics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FNS_graphics"
        mc:Ignorable="d"
        Title="Панель шифрования и дешифрования"
        Height="760"
        Width="1000"
        WindowState="Maximized"
        MinHeight="680"
        Loaded="Window_Loaded"
        MinWidth="860">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="#FFF2F8F2" />
            <Setter Property="Foreground" Value="#FF1F3A2A" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F8F1" />
            <Setter Property="BorderBrush" Value="#FFC4DCC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderBrush" Value="#FFB6CCB8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4,12,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="#FF70B07D" />
            <Setter Property="Foreground" Value="#FF193B26" />
            <Setter Property="BorderBrush" Value="#FF5A996A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SoftToggleContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFE2ECE3" />
            <Setter Property="BorderBrush" Value="#FF9FB9A3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="SoftToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF274235" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.EncryptCommand}" Executed="EncryptCommand_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.DecryptCommand}" Executed="DecryptCommand_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{x:Static local:MainWindow.EncryptCommand}" />
        <KeyBinding Key="Enter" Modifiers="Shift" Command="{x:Static local:MainWindow.DecryptCommand}" />
    </Window.InputBindings>

    <Grid Margin="6">
        <StackPanel Visibility="Collapsed">
            <CheckBox x:Name="BuildJsonFileCheckBox" IsChecked="True" />
            <CheckBox x:Name="DisableReedSolomonForJsonCheckBox" IsChecked="True" />
            <CheckBox x:Name="AutoSenderKeyGenerationCheckBox" IsChecked="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleStyle}" Margin="0">Шифрование</TextBlock>
                            <Button Grid.Column="1"
                                    Content="Настройки шифрования"
                                    Click="SwitchesWindowButton_Click"
                                    Margin="10,0,0,0"
                                    Background="#FF6FAAE6"
                                    BorderBrush="#FF567DA2"
                                    Foreground="#FF1A3348" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="EncryptActionColumn" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0">Исходный текст</TextBlock>
                                <TextBlock x:Name="EncryptMetricsTextBlock"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Foreground="#FF3F5A45" />
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="EncryptActionColumn" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceTextBox" Grid.Column="0" />
                            <Button x:Name="EncryptButton" Grid.Column="1" Content="Шифровать" Click="Encrypt_Click" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleStyle}" Margin="0">Ключи гибридного шифрования ECDH</TextBlock>
                            <Button Grid.Column="1"
                                    Content="Настройка связей ключей"
                                    Click="DigitalSignatureSettingsButton_Click"
                                    Margin="10,0,0,0"
                                    Background="#FF6FAAE6"
                                    BorderBrush="#FF567DA2"
                                    Foreground="#FF1A3348" />
                        </Grid>

                        <TextBlock>Публичный ключ отправителя (ECDH)</TextBlock>
                        <TextBox x:Name="SharedSenderPublicKeyTextBox" Margin="0,0,0,8" />

                        <TextBlock>Подпись пакета отправителя (ECDSA)</TextBlock>
                        <TextBox x:Name="SharedSenderPublicKeySignatureTextBox" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Margin="0">Слепок публичного ключа подписи отправителя (SHA-256)</TextBlock>
                            <TextBlock x:Name="ActiveRecipientLinkTextBlock"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#FF3F5A45"
                                       Text="Связь: не выбрана" />
                        </Grid>
                        <TextBox x:Name="SharedReceiverPublicKeyFingerprintTextBox" IsReadOnly="True" Margin="0,0,0,8" />

                        <TextBlock>Защищённые данные для восстановления симметричного ключа</TextBlock>
                        <TextBox x:Name="SharedSessionKeyTextBox" IsReadOnly="True" Margin="0,0,0,8" />

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SectionTitleStyle}" Margin="0">Дешифрование</TextBlock>
                            <Button Grid.Column="1"
                                    Content="Выбрать JSON файл"
                                    Click="SelectDecryptJsonFileButton_Click"
                                    Margin="10,0,0,0"
                                    Background="#FFD5E3D6"
                                    BorderBrush="#FF8EA691"
                                    Foreground="#FF2B4631" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DecryptActionColumn" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0">Шифротекст</TextBlock>
                                <TextBlock x:Name="DecryptMetricsTextBlock"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Foreground="#FF3F5A45" />
                            </Grid>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DecryptActionColumn" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TransferCipherTextTextBox" Grid.Column="0" />
                            <Button x:Name="DecryptButton" Grid.Column="1" Content="Дешифровать" Click="Decrypt_Click" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock" Foreground="#FF2E6A42" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
